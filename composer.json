{
    "name": "vindi/vindi-magento2",
    "description": "Módulo de cobrança Vindi para o Magento 2",
    "type": "magento2-module",
    "version": "2.4.0",
    "license": "GPL-3.0",
    "authors": [
        {
            "email": "comunidade@vindi.com.br",
            "name": "Comunidade Vindi"
        }
    ],
    "minimum-stability": "dev",
    "require": {},
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "Vindi\\Payment\\": ""
        }
    },
    "require-dev": {
        "magento/magento-coding-standard": "^41",
        "phpstan/phpstan": "^2.1",
        "bitexpert/phpstan-magento": "^0.44",
        "phpstan/extension-installer": "^1.4"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
